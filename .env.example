# Anime Witcher/Firebase source
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=animewitcher-1c66d
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=

# Optional: only enable after receiving an authorized Anime Slayer API contract
ANIMESLAYER_ENABLED=false
ANIMESLAYER_BASE_URL=https://anslayer.com/anime/public/
# Set only to an authorized JSON endpoint that accepts q/title/episode.
ANIMESLAYER_ENDPOINT=

# Production job persistence/queue on Railway or Render
DATABASE_URL=
REDIS_URL=

# Upload18 server-side integration: use a restricted Upload+Read key, never the master key
UPLOAD18_API_BASE=https://upload18.net/api
UPLOAD18_API_KEY=
UPLOAD18_CATEGORY_ID=19
UPLOAD18_FOLDER_ID=

# Bunny Stream library used for organized server-side video storage
BUNNY_STREAM_LIBRARY_ID=791325
BUNNY_STREAM_LIBRARY_NAME=AnimeHub.Clean
# Optional comma-separated catalog: library_id:display name,library_id:display name
BUNNY_STREAM_LIBRARIES=792346:AnimeHub.Movies1-720p,792349:AnimeHub.Movies2-720p,792350:AnimeHub.Movies3-720p,792351:AnimeHub.Movies4-720p
BUNNY_STREAM_API_KEY=
# JSON object containing one write key per library; keep it only in Render secrets.
BUNNY_STREAM_LIBRARY_KEYS={}
# JSON object containing the CDN hostname for each library.
BUNNY_STREAM_LIBRARY_CDNS={}
BUNNY_STREAM_API_BASE=https://video.bunnycdn.com
BUNNY_STREAM_CDN_HOSTNAME=vz-5b2e963b-730.b-cdn.net
BUNNY_STREAM_PLAYER_BASE=https://iframe.mediadelivery.net/embed

# Browser admin page (set both secrets in Render/Railway; never commit real values)
ANIMEHUB_ADMIN_PASSWORD=
ANIMEHUB_ADMIN_SESSION_SECRET=

# Bounded parallelism: eight works and eight Bunny submissions by default.
ANIMEHUB_MAX_WORK_CONCURRENCY=8
ANIMEHUB_MEDIA_TRANSFER_CONCURRENCY=8
